# Delete the `megacorp` index in case it already exists
DELETE /megacorp

# Index our example documents
PUT /megacorp/_doc/1
{
    "first_name" : "John",
    "last_name" :  "Smith",
    "age" :        25,
    "about" :      "I love to go rock climbing",
    "interests": [ "sports", "music" ]
}

PUT /megacorp/_doc/2
{
    "first_name" :  "Jane",
    "last_name" :   "Smith",
    "age" :         32,
    "about" :       "I like to collect rock albums",
    "interests":  [ "music" ]
}

PUT /megacorp/_doc/3
{
    "first_name" :  "Douglas",
    "last_name" :   "Fir",
    "age" :         35,
    "about":        "I like to build cabinets",
    "interests":  [ "forestry" ]
}

# Search for all employees in the megacorp index:
GET /megacorp/_doc/_search

# Search for all employees in the megacorp index
# who have "Smith" in the last_name field
GET /megacorp/_doc/_search?q=last_name:Smith

# Same query as above, but using the Query DSL
GET /megacorp/_doc/_search
{
  "query": {
    "match": {
      "last_name": "smith"
    }
  }
}

